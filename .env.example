# CIS environment variables
#
# Copy to `.env` in the repo root (or the repo you index with cisd).
# `cisd` / `cis-mcp` call `load_env_file()` at startup: values here are applied
# only when the same key is not already set in the shell.
#
# Boolean flags: use `1` / `0` (some also accept `true` / `false`).

# =============================================================================
# Repository & daemon
# =============================================================================

# Repository root to index and persist `.cis/` state under.
# CIS_REPO_ROOT=.

# Path to search ranking policy YAML (default: .cis/ranking_policy.yaml).
# CIS_POLICY_PATH=.cis/ranking_policy.yaml

# Durable file for vector-cleanup dead-letter queue (default: in-memory).
# CIS_VECTOR_DLQ_PATH=.cis/vector_dlq.jsonl

# =============================================================================
# MCP server
# =============================================================================

# Default MCP session id when tool calls omit `session_id` (default: 0 = admin).
# CIS_SESSION_ID=0

# MCP tool response encoding: `json` returns structured JSON content blocks.
# CIS_MCP_CONTENT_MODE=json

# Skip the startup Python tree walk (use when graph is already loaded).
# CIS_MCP_SKIP_INDEX=0

# `cis-mcp` runs in-process instead of exec'ing `cisd --mcp`.
# CIS_STANDALONE_MCP=0

# =============================================================================
# Filesystem sync (watcher)
# =============================================================================

# Background FS watcher and auto-reindex (set `0` to disable).
# CIS_FS_SYNC=1

# Force mtime polling only (no native inotify/kqueue).
# CIS_FS_POLL_ONLY=0

# Disable native notify watcher (requires `fs-notify` build feature).
# CIS_FS_NOTIFY=1

# Use notify plus periodic mtime poll as a safety net.
# CIS_FS_POLL_FALLBACK=0

# Debounce delay before re-indexing after FS events (ms, default: 300).
# CIS_INDEX_DEBOUNCE_MS=300

# Mtime poll interval when notify is unavailable (ms, default: 500).
# CIS_FS_POLL_MS=500

# Alternate poll interval in seconds (used when CIS_FS_POLL_MS is unset).
# CIS_FS_WATCH_POLL_SECS=1

# =============================================================================
# Indexing & persistence
# =============================================================================

# Re-walk the repo on startup even when a graph snapshot exists.
# CIS_FORCE_REINDEX=0

# Write `.cis/` snapshots during incremental reindex (set `0` to defer until
# MCP `save_workspace`).
# CIS_REINDEX_PERSIST=1

# Honor `.gitignore` during indexing (set `0` for legacy recursive walk).
# CIS_INDEX_RESPECT_GITIGNORE=1

# =============================================================================
# Branches & git integration
# =============================================================================

# Mirror `.git/HEAD` into CIS active branch (opt-in).
# CIS_GIT_BRANCH_SYNC=0

# When git branch sync is on, auto-fork CIS branch bindings on git branch switch.
# CIS_GIT_BRANCH_AUTO_FORK=1

# =============================================================================
# Embeddings & semantic search (requires `api-embeddings` build feature)
# =============================================================================

# OpenAI-compatible embeddings base URL (include `/v1` suffix).
# Local server: ./scripts/run_embed_server.sh
CIS_EMBED_API_URL=http://127.0.0.1:8080/v1

# Model name sent to the embedding API.
CIS_EMBED_MODEL=all-MiniLM-L6-v2

# Expected vector dimension (384 for all-MiniLM-L6-v2; 1536 for OpenAI small).
CIS_EMBED_DIM=384

# API key (optional for local embed server; required for hosted APIs).
# CIS_EMBED_API_KEY=

# Max texts per HTTP embed request (default: 16).
# CIS_EMBED_BATCH=16

# HTTP timeout for embed requests in milliseconds (default: 30000).
# CIS_EMBED_TIMEOUT_MS=30000

# =============================================================================
# Storage backends (requires `body-sqlite` build feature for sqlite)
# =============================================================================

# Symbol body blobs: `file` (.cis/bodies/) or `sqlite`.
# CIS_BODY_BACKEND=file

# KV / metadata: `json` (kv.json) or `sqlite` (.cis/store.db).
# CIS_METADATA_BACKEND=json

# Graph store: `json` (graph.json) or `sqlite` (graph.db).
# CIS_GRAPH_BACKEND=json

# When graph backend is sqlite, still export graph.json unless set to `0`.
# CIS_GRAPH_JSON_EXPORT=1

# Fail migration/CLI commands instead of falling back when sqlite is unavailable.
# CIS_MIGRATION_STRICT=0

# =============================================================================
# Performance & concurrency
# =============================================================================

# Use RwLock instead of Mutex for the in-memory graph (concurrent read queries).
# CIS_GRAPH_RWLOCK=0

# =============================================================================
# Testing & development only
# =============================================================================

# In-memory WAL — no durable `.cis/wal.json` (parallel tests, demos).
# CIS_WAL_MEMORY=0

# Skip loading graph.json / kv.json on startup (pair with bootstrap or tests).
# CIS_SKIP_WORKSPACE_LOAD=0

# Skip recovering in-flight merge sagas on startup (tests only).
# CIS_SKIP_MERGE_RECOVER=0

# Fault injection for crash/stress tests. Formats:
#   crash_after:N
#   delay:min_ms-max_ms:seed
#   fail:wal|graph|vector|kv|token|saga|identity|all
# CIS_FAULT_INJECTOR=

# Enable Phase 1 hot-path benchmark gate (cargo test --ignored).
# CIS_RUN_BENCHMARKS=0

# =============================================================================
# Scripts only (not read by cisd; used by setup_embed_venv.sh / run_embed_server.sh)
# =============================================================================

# Override path to the Python venv for the local embed server (default: .venv-embed).
# CIS_EMBED_VENV=.venv-embed
